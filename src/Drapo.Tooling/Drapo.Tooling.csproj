<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>Drapo.Tooling</RootNamespace>
		<Description>Drapo engine catalog, documentation services and template validator shared by the docs site, its MCP server and the Drapo language server. No ASP.NET dependency.</Description>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Drapo" Version="2026.9.9.9">
			<ExcludeAssets>contentfiles</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
</Project>
